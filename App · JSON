{
  "expo": {
    "name": "Basta",
    "slug": "basta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3A1F6E"
      },
      "package": "com.edensantos.calculadora",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.SEND_SMS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Este app usa sua localização para enviar no alerta de emergência.",
          "locationAlwaysPermission": "Permite rastrear sua localização em segundo plano durante situações de risco.",
          "locationWhenInUsePermission": "Permite enviar sua localização no SOS."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite salvar fotos como evidências no Diário.",
          "cameraPermission": "Permite tirar fotos e gravar vídeos como evidências."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Permite gravar áudio secretamente como evidência."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite escutar a frase-código para acionar o SOS automaticamente.",
          "speechRecognitionPermission": "Permite reconhecer a frase-código para acionar o SOS.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"],
          "foregroundService": {
            "notificationTitle": "Basta — Proteção ativa",
            "notificationDescription": "Monitorando frase de segurança em segundo plano.",
            "notificationColor": "#6B3FA0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6B3FA0",
          "androidMode": "default"
        }
      ]
    ],
    "owner": "basta.appoficial",
    "ios": {},
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
} 
